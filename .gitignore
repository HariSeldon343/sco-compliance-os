# =========================================================================
# SCO Compliance OS — .gitignore
# Stack: Rust (Tauri 2) + Python (FastAPI sidecar) + TypeScript (React 19) + pnpm
# =========================================================================

# ----- OS noise -----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ----- Editor / IDE -----
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/
*.code-workspace

# ----- Node / pnpm (frontend + monorepo root) -----
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npmrc.local

# ----- Vite + React build -----
frontend/dist/
frontend/.vite/
frontend/stats.html
.tsbuildinfo
*.tsbuildinfo

# ----- Rust / Tauri -----
target/
frontend/src-tauri/target/
frontend/src-tauri/gen/schemas/
frontend/src-tauri/Cargo.lock.bak
**/*.rs.bk
frontend/src-tauri/WixTools/

# ----- Python (backend sidecar) -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/.venv-pyinstaller/
backend/venv/
backend/env/
backend/build/
backend/dist/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/uv.lock.bak

# ----- PyInstaller artifacts -----
backend/*.spec.bak
backend/build-pyinstaller/
backend/dist-pyinstaller/

# ----- Secrets / env -----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
private/

# ----- Tauri signing keys -----
.tauri/signing.key
.tauri/signing.key.pub
~/.tauri/*.key

# ----- Build outputs / installers -----
dist/
dist-portable/
build/
out/
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.exe
!scripts/**/*.exe.template

# ----- Logs -----
*.log
logs/
build-*.log
backend.log
frontend.log

# ----- Cache / temporanei -----
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
tmp/
temp/

# ----- Lockfile policy -----
# pnpm-lock.yaml viene committato (monorepo single lockfile)
# package-lock.json e yarn.lock vanno esclusi per evitare conflitti
package-lock.json
yarn.lock

# ----- User-specific runtime data -----
*.sqlite
*.sqlite-journal
*.db
*.db-journal
user-data/

# ----- Anthropic / MCP runtime cache -----
.anthropic-cache/
.mcp-cache/

# ----- Backup files -----
*.bak
*.orig
*~
*.rej
