# ============================================================================
# SCO Compliance OS — backend env vars (template .env.example)
# ----------------------------------------------------------------------------
# Copia questo file in `backend/.env` e popola con i valori reali.
# Il file `.env` è gitignored: contiene segreti.
# load_dotenv(override=True) viene chiamato in main.py per garantire che i valori
# qui vincano sull'ambiente di shell (Conv. 44 lesson 1 enforcement).
# ============================================================================

# ----- Anthropic API key (OBBLIGATORIA in runtime) -----
# Ottenibile da https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ----- Modelli -----
# v0.12.0 (25/05/2026): default bumped a Opus 4.7 per allineare al SaaS.
# Overridabile per tenant via SaaS /api/v1/tenant/me/llm-config.
MODEL_DEFAULT=claude-opus-4-7
MODEL_FAST=claude-haiku-4-5-20251001

# ----- Server -----
# Porta backend: 7800 di default per evitare clash con sco-agent-local (7777).
BACKEND_PORT=7800
BACKEND_HOST=127.0.0.1

# ----- CORS (Conv. 44 lesson 2 — Tauri 2 WebView2) -----
# Lascia vuoto per usare i 5 default (localhost:1420 + 127.0.0.1:1420 +
# tauri://localhost + http://tauri.localhost + https://tauri.localhost).
# Override con lista CSV se servono altri host. Usa "*" SOLO in dev locale.
# CORS_ORIGINS=http://localhost:1420,tauri://localhost

# ----- Filesystem -----
# DATA_DIR contiene DB SQLite + onboarding.json + vault_registry.json + log.
# Default: ~/.sco-compliance-os
# DATA_DIR=C:\Users\aoedo\.sco-compliance-os

# Vault SCO di default da pre-caricare a startup (opzionale).
# VAULT_DEFAULT_PATH=C:\Users\aoedo\Desktop\Second Brain

# ----- Logging + monitoring -----
LOG_LEVEL=INFO

# DSN Sentry opzionale per error tracking in produzione.
# Lascia vuoto per disabilitare Sentry.
# SENTRY_DSN=https://xxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
